cat > check.sh << 'EOF'
#!/bin/bash
if [ $# -eq 0 ]; then
    echo "Usage: ./check.sh <name>"
    exit 1
fi
if [ -d "$1" ]; then
    echo "$1 is a directory"
elif [ -f "$1" ]; then
    echo "$1 is a file"
else
    echo "$1 does not exist"
fi
EOF
chmod +x check.sh
mkdir -p MIET
touch file.txt
./check.sh MIET
./check.sh file.txt
./check.sh abc
