cat > string_ops.sh << 'EOF'
#!/bin/bash

str="Model Institute of Engineering and Technology"
start=6
length=9

# String length using ${#str}
echo "String: $str"
echo "Length: ${#str}"

# Substring using ${str:start:length}
echo "Substring ($start,$length): ${str:$start:$length}"
EOF
chmod +x string_ops.sh
./string_ops.sh
cat > string_ops.c << 'EOF'
#include <stdio.h>

int main() {
    char str[] = "Model Institute of Engineering and Technology";
    char sub[50];
    int start = 6, length = 9;
    int i, len = 0;

    /* String length: count until null terminator */
    while (str[len] != '\0')
        len++;

    /* Substring: copy characters into buffer */
    for (i = 0; i < length && str[start + i] != '\0'; i++)
        sub[i] = str[start + i];
    sub[i] = '\0';

    printf("String: %s\n", str);
    printf("Length: %d\n", len);
    printf("Substring (%d,%d): %s\n", start, length, sub);
    return 0;
}
EOF
gcc string_ops.c -o string_ops
./string_ops
cat > bench.c << 'EOF'
#include <stdio.h>

int main() {
    char str[] = "Model Institute of Engineering and Technology";
    char sub[50];
    int start = 6, length = 9, len = 0, i, n;
    volatile int sink = 0;

    for (n = 0; n < 100000000; n++) {
        len = 0;
        while (str[len] != '\0') len++;
        for (i = 0; i < length && str[start + i] != '\0'; i++)
            sub[i] = str[start + i];
        sub[i] = '\0';
        sink += len + sub[0];
    }
    printf("Length: %d  Substring: %s\n", len, sub);
    return 0;
}
EOF
gcc -O0 bench.c -o bench
time ./bench
