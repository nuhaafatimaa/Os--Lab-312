cat > memory.c << 'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

#define PAGE 4096

int main(int argc, char *argv[]) {
    if (argc != 2) {
        printf("Usage: ./memory <N in MB>\n");
        return 1;
    }

    long n = atol(argv[1]);
    size_t size = (size_t)n * 1024 * 1024;

    printf("PID: %d\n", getpid());
    printf("Press Enter to allocate %ld MB...", n);
    getchar();

    char *p = malloc(size);
    if (p == NULL) {
        perror("malloc");
        return 1;
    }
    printf("Allocated %ld MB (virtual only, nothing written yet)\n", n);
    printf("Check VSZ/RSS now. Press Enter to start touching pages...");
    getchar();

    size_t pages = size / PAGE;
    for (size_t i = 0; i < pages; i++) {
        p[i * PAGE] = 1;                 /* one write per page -> page fault */
        if (i % (pages / 10) == 0) {
            printf("Touched %zu%% of pages\n", (i * 100) / pages);
            fflush(stdout);
            sleep(1);
        }
    }
    printf("All %zu pages touched. Press Enter to free and exit...", pages);
    getchar();

    free(p);
    return 0;
}
EOF
gcc memory.c -o memory
